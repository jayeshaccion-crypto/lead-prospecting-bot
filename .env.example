# Required: base64-encoded Google service account JSON key
GOOGLE_SA_KEY=

# Required: enrichment provider API key
ENRICH_API_KEY=

# Required: Google Spreadsheet ID (from sheet URL)
SHEET_ID=

# Optional: path to target sites YAML config (default: config/targets.yml)
TARGETS_CONFIG=config/targets.yml

# Optional: Python log level (default: INFO)
LOG_LEVEL=INFO
